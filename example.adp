calculate_adp : false           ! don't calculate atomic displacement paramters
calculate_ke : true             ! calculate the kinetic energy - turns on write_ke
equilibration_timesteps : 1000  ! number of equilibration timesteps in the md
r_equilibrium : finite          ! how to calculate r_equilibrium
write_adp : false               ! don't write atomic displacement paramters
write_jmol : false              ! don't write out a jmol .spt file
write_ke : true                 ! write out kinetic energy tensor
write_r_eq : true               ! write out equilibrium positions
write_uij : false               ! don't write out Uij